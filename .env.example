# ─── Supabase ───────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Site ─────────────────────────────────────────────────────────────────────
# Use www subdomain — matches production and Supabase redirect URLs
NEXT_PUBLIC_SITE_URL=https://www.keragroup.ge

# Supabase Dashboard → Authentication → URL Configuration:
#   Site URL: https://www.keragroup.ge
#   Redirect URLs (add all):
#     https://www.keragroup.ge/auth/callback
#     https://keragroup.ge/auth/callback
#     https://www.keragroup.ge/**
#     https://keragroup.ge/**

# ─── Cadastral (NAPR public registry) ────────────────────────────────────────
CADASTRAL_API_URL=http://gisappsn.reestri.gov.ge/ArcGIS/rest/services/CadRepGeo/MapServer

# ─── Admin ────────────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-admin-password
ADMIN_SESSION_SECRET=kera-admin-session-secret-2026
